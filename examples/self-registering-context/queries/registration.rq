PREFIX jsonld: <http://www.w3.org/ns/json-ld#>
PREFIX schema: <http://schema.org/>
PREFIX sparqld: <https://sparqld.iolanta.tech/>

ASK {
  {
    <sparqld:contexts/person.yamlld> sparqld:defines-context ?context .
  }
  UNION
  {
    GRAPH <sparqld:contexts/person.yamlld> {
      [] a jsonld:Context ;
        schema:contentUrl ?context .
    }
  }
}
