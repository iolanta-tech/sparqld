"@context":
  rdf: http://www.w3.org/1999/02/22-rdf-syntax-ns#
  pm: https://vocab.methodandstructure.com/process-model#
  rdfs: http://www.w3.org/2000/01/rdf-schema#
  title: rdfs:label
  schema: https://schema.org/
  ibis: https://vocab.methodandstructure.com/ibis#
  status:
    "@id": pm:status
    "@type": "@vocab"
    "@context":
      "@vocab": "urn:roadmap:status:"
  blockedBy:
    "@reverse": urn:sparqld:vocabulary:blocks
    "@type": "@id"
  blocks:
    "@id": urn:sparqld:vocabulary:blocks
    "@type": "@id"
  contributesTo:
    "@id": urn:sparqld:vocabulary:contributesTo
    "@type": "@id"
  subClassOf:
    "@id": rdfs:subClassOf
    "@type": "@id"
  subjectOf:
    "@id": schema:subjectOf
    "@type": "@id"
  domain:
    "@id": rdfs:domain
    "@type": "@id"
  range:
    "@id": rdfs:range
    "@type": "@id"
  seeAlso:
    "@id": rdfs:seeAlso
    "@type": "@id"
"@type": http://www.w3.org/ns/json-ld#Context
http://schema.org/contentUrl:
  "@id": urn:sparqld:roadmap
$included:
- $id: urn:roadmap:status:open
  $type: ibis:State
  rdfs:label: open
- $id: urn:roadmap:status:closed
  $type: ibis:State
  rdfs:label: closed
- $id: urn:roadmap:status:cancelled
  $type: ibis:State
  rdfs:label: cancelled
- $id: urn:sparqld:vocabulary:blocks
  $type: rdf:Property
  rdfs:label: blocks
  rdfs:comment: Links a prerequisite to the roadmap item that it blocks.
- $id: urn:sparqld:vocabulary:contributesTo
  $type: rdf:Property
  rdfs:label: contributes to
  rdfs:comment: Links an outcome to the enduring mission it advances.
- $id: urn:sparqld:vocabulary:Bug
  $type: rdfs:Class
  rdfs:label: Bug
  rdfs:comment: A reported defect in sparqld behavior.
  subClassOf: pm:Task
